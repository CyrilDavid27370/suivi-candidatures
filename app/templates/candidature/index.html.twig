{% extends 'base.html.twig' %}

{% block title %}Mes candidatures{% endblock %}

{% block body %}
    <h1>Mes candidatures</h1>

    <form method="get">
        <input type="text" name="q" value="{{ recherche }}" placeholder="Entreprise ou poste">

        <select name="statut">
            <option value="">Tous les statuts</option>
            {% for statut in statuts %}
                <option value="{{ statut.value }}" {{ statutActuel == statut ? 'selected' }}>
                    {{ statut.label }}
                </option>
            {% endfor %}
        </select>

        <select name="tri">
            <option value="desc" {{ tri == 'desc' ? 'selected' }}>Plus récentes d'abord</option>
            <option value="asc" {{ tri == 'asc' ? 'selected' }}>Plus anciennes d'abord</option>
        </select>

        <button type="submit">Filtrer</button>
        <a href="{{ path('app_candidature_index') }}">Réinitialiser</a>
    </form>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Poste</th>
                <th>Entreprise</th>
                <th>Lieu</th>
                <th>TypeContrat</th>
                <th>Source</th>
                <th>UrlOffre</th>
                <th>DateCandidature</th>
                <th>Statut</th>
                <th>Notes</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for candidature in candidatures %}
            <tr>
                <td>{{ candidature.id }}</td>
                <td>{{ candidature.poste }}</td>
                <td>{{ candidature.entreprise }}</td>
                <td>{{ candidature.lieu }}</td>
                <td>{{ candidature.typeContrat }}</td>
                <td>{{ candidature.source }}</td>
                <td>{{ candidature.urlOffre }}</td>
                <td>{{ candidature.dateCandidature ? candidature.dateCandidature|date('Y-m-d') : '' }}</td>
                <td>{{ candidature.statut?.label }}</td>
                <td>{{ candidature.notes }}</td>
                <td>
                    <a href="{{ path('app_candidature_show', {'id': candidature.id}) }}">show</a>
                    <a href="{{ path('app_candidature_edit', {'id': candidature.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="11">Aucune candidature trouvée</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_candidature_new') }}">Create new</a>
{% endblock %}